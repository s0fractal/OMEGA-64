{
  "compilerOptions": {
    "lib": [
      "deno.window"
    ],
    "strict": true
  },
  "tasks": {
    "lint": "deno lint",
    "core:export": "deno run -A 07/02/export_core.ts",
    "core:refresh": "deno task core:export",
    "core:pulse": "deno run -A PULSE.ts",
