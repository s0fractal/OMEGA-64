st:physiology-api && deno task test:telemetry-stream-contract && deno task test:codex-narrative-contract && deno task test:ui-codex-narrative-contract && deno task test:ui-human-channel-contract && deno task test:ui-spatial-hash-guard-contract && deno task test:ui-webrtc-mesh-contract && deno task test:runtime-support-boundary && deno task test:runtime-experimental-boundary && deno task test:export-manifest && deno task test:export-file-set && deno task test:export-runtime-topology && deno task test:export-provenance && deno task test:glyphir64-contract && deno task test:opcode-to-glyph-contract && deno task test:golden-trace-catalog && deno task test:golden-trace-artifacts && deno task test:admission-diff-artifacts && deno task test:reduction-cases && deno task test:reduction-harness && deno task test:reduction-diff-artifacts && deno task vector10:verify && deno task test:worker-determinism && deno task test:structure-js && deno task test:structure-parity && deno task test:structure-lock-progress && deno task test:crystalline && deno task test:quantum && deno task test:quantum-mycelium && deno task test:topological-signature && deno task test:invariant-packet && deno task test:bridge-policy && deno task test:proposal-envelope-index && deno task test:ledger-chain && deno task test:checkpoint-chain && deno task test:architecture-guard",
