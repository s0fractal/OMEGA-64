{
  "compilerOptions": { "lib": ["deno.window"], "strict": true },
  "tasks": {
    "lint": "deno lint",
    "audit:determinism": "deno run -A e/CRYSTALLIZE.ts DETERMINISM_AUDIT.md --run",
    "audit:root": "deno run -A e/AUDIT_ROOT_CANON.ts",
    "export:sigma": "deno run -A e/EXPORT_SIGMA_CANON.ts --mode entity",
    "sigma:verify": "deno run -A e/legacy/sigma_quine.ts --input I.sigma.md --verify",
    "sigma:index": "deno run -A e/legacy/sigma_index.ts --input I.sigma.md --output I.sigma.index.json",
    "canon:mod": "deno run -A e/GENERATE_MOD_TS.ts",
    "glider:breathe": "deno run -A e/RIBOSOME_ZERO.ts",
    "core:export": "deno run -A export_core.ts",
    "core:refresh": "deno task core:export",
    "core:pulse": "deno run -A PULSE.ts",
    "core:breath": "deno run -A BREATH.ts",
    "core:ui": "deno run -A OBSERVER_UI.ts",
    "core:start": "deno run -A SYSTEM_START.ts",
    "membrane:test": "deno run -A SEMANTIC_MEMBRANE.ts",
    "membrane:inject": "deno eval 'import { SEMANTIC_MEMBRANE } from \"./SEMANTIC_MEMBRANE.ts\"; await SEMANTIC_MEMBRANE.injectThought(Deno.args[0] || \"Default Thought\", Number(Deno.args[1]) || 100)' --",
    "check:canon": "deno task lint && deno task canon:mod && deno task glider:breathe",
    "wasm:layout": "deno run -A wasm_layout_guard.ts",
    "wasm:build": "deno run -A build_wasm.ts",
    "test:resonance": "deno run -A test_resonance_protocol.ts",
    "test:swarm": "deno run -A test_swarm.ts",
    "test:tensegrity": "deno run -A test_tensegrity.ts",
    "test:quantum": "deno run -A test_quantum_shift.ts",
    "test:quantum-mycelium": "deno run -A test_quantum_mycelium.ts",
    "test:crystalline": "deno run -A test_crystalline_lattice.ts",
    "test:neural": "deno run -A test_neural_synthesis.ts",
    "test:structure-js": "deno run -A test_structure_engine.ts",
    "test:structure-parity": "deno run -A test_structure_parity.ts",
    "test:structure-lock-progress": "deno run -A test_structure_lock_progress.ts",
    "test:worker-coherence": "deno run -A test_wasm_worker_coherence.ts",
    "test:worker-coherence:long": "OMEGA_WORKER_COHERENCE_TICKS=1000 OMEGA_WORKER_COHERENCE_LOG_EVERY=100 deno run -A test_wasm_worker_coherence.ts",
    "test:worker-determinism": "deno run -A test_worker_determinism.ts",
    "test:spawn-determinism": "deno run -A test_spawn_determinism.ts",
    "test:spawn-jitter-resilience": "deno run -A test_spawn_jitter_resilience.ts",
    "test:worker-timeout-retry": "deno run -A test_worker_timeout_retry.ts",
    "test:worker-timeout-retry:multi": "deno run -A test_worker_timeout_retry_multi.ts",
    "test:worker-jitter-resilience": "deno run -A test_worker_jitter_resilience.ts",
    "test:worker-init-fallback": "deno run -A test_worker_init_fallback.ts",
    "test:worker-init-total-fail": "deno run -A test_worker_init_total_fail.ts",
    "test:worker-init-safe-noop": "deno run -A test_worker_init_safe_noop.ts",
    "test:worker-resilience-audit": "deno run -A test_worker_resilience_audit.ts",
    "test:worker-resilience-budget": "deno task test:worker-resilience-audit && deno run -A test_worker_resilience_budget.ts",
    "test:worker-resilience-trend": "deno task test:worker-resilience-budget && deno run -A test_worker_resilience_trend.ts",
    "test:worker-soak-stability": "deno run -A test_worker_soak_stability.ts",
    "test:worker-soak-trend": "deno task test:worker-soak-stability && deno run -A test_worker_soak_trend.ts",
    "test:startup-selftest-fallback": "deno run -A test_startup_selftest_fallback.ts",
    "test:startup-selftest-nominal": "deno run -A test_startup_selftest_nominal.ts",
    "test:worker-determinism-fuzz": "deno run -A test_worker_determinism_fuzz.ts",
    "test:worker-drift-audit": "deno run -A test_worker_drift_audit.ts",
    "test:structure-intent-determinism": "deno run -A test_structure_intent_determinism.ts",
    "test:runtime-monoculture": "deno run -A test_runtime_monoculture.ts",
    "test:runtime-logging": "deno run -A test_runtime_logging.ts",
    "test:runtime-state-matrix-api": "deno run -A test_runtime_state_matrix_api_guard.ts",
    "test:attention-field": "deno run -A test_attention_field_runtime.ts",
    "test:env-parse-monoculture": "deno run -A test_env_parse_monoculture_contract.ts",
    "test:runtime-std-import-policy": "deno run -A test_runtime_std_import_policy.ts",
    "test:runtime-std-version-policy": "deno run -A test_runtime_std_version_policy.ts",
    "test:mutation-lane-contract": "deno run -A test_mutation_lane_contract.ts",
    "test:mutation-telemetry-contract": "deno run -A test_mutation_telemetry_contract.ts",
    "test:gate-decomposition-contract": "deno run -A test_gate_decomposition_contract.ts",
    "test:oracle-mutation-serialization": "deno run -A test_oracle_mutation_serialization_contract.ts",
    "test:oracle-plasmid-mode": "deno run -A test_oracle_plasmid_mode_contract.ts",
    "test:control-intent-serialization": "deno run -A test_control_intent_serialization_contract.ts",
    "test:p2p-ingress-policy": "deno run -A test_p2p_ingress_policy_contract.ts",
    "test:pulse-clock-contract": "deno run -A test_pulse_clock_contract.ts",
    "test:log-level-policy": "deno run -A test_log_level_policy.ts",
    "test:export-manifest": "deno run -A test_export_manifest_guard.ts",
    "test:export-file-set": "deno run -A test_export_file_set_guard.ts",
    "test:export-provenance": "deno run -A test_export_provenance_guard.ts",
    "test:topological-signature": "deno run -A test_topological_signature_runtime.ts",
    "test:invariant-packet": "deno run -A test_invariant_packet_runtime.ts",
    "test:bridge-policy": "deno run -A test_bridge_policy_runtime.ts",
    "test:proposal-envelope-index": "deno run -A test_proposal_envelope_index_runtime.ts",
    "test:ledger-chain": "deno run -A test_ledger_chain_runtime.ts",
    "test:checkpoint-chain": "deno run -A test_checkpoint_chain_runtime.ts",
    "test:active": "deno task verify:coherence:deep",
    "ci:verify:worker1": "OMEGA_PULSE_WORKERS=1 deno task verify:coherence:deep",
    "ci:verify:worker4": "OMEGA_PULSE_WORKERS=4 deno task verify:coherence:deep",
    "ci:verify:matrix": "deno task ci:verify:worker1 && deno task ci:verify:worker4",
    "ci:soak:worker4": "OMEGA_PULSE_WORKERS=4 deno task test:worker-coherence:long && deno task test:worker-resilience-trend && deno task test:worker-soak-trend",
    "vector10:verify": "deno task wasm:build && deno task test:worker-coherence && deno task test:resonance && deno task test:swarm && deno task test:tensegrity",
    "verify:coherence": "deno task test:runtime-monoculture && deno task test:runtime-logging && deno task test:runtime-state-matrix-api && deno task test:attention-field && deno task test:env-parse-monoculture && deno task test:runtime-std-import-policy && deno task test:runtime-std-version-policy && deno task test:mutation-lane-contract && deno task test:mutation-telemetry-contract && deno task test:gate-decomposition-contract && deno task test:oracle-mutation-serialization && deno task test:oracle-plasmid-mode && deno task test:control-intent-serialization && deno task test:p2p-ingress-policy && deno task test:pulse-clock-contract && deno task test:log-level-policy && deno task test:export-manifest && deno task test:export-file-set && deno task test:export-provenance && deno task vector10:verify && deno task test:worker-determinism && deno task test:structure-js && deno task test:structure-parity && deno task test:structure-lock-progress && deno task test:crystalline && deno task test:neural && deno task test:quantum && deno task test:quantum-mycelium && deno task test:topological-signature && deno task test:invariant-packet && deno task test:bridge-policy && deno task test:proposal-envelope-index && deno task test:ledger-chain && deno task test:checkpoint-chain",
    "verify:coherence:deep": "deno task verify:coherence && deno task test:worker-drift-audit && deno task test:worker-determinism-fuzz && deno task test:structure-intent-determinism && deno task test:spawn-determinism && deno task test:spawn-jitter-resilience && deno task test:worker-timeout-retry && deno task test:worker-timeout-retry:multi && deno task test:worker-jitter-resilience && deno task test:worker-init-fallback && deno task test:worker-init-total-fail && deno task test:worker-init-safe-noop && deno task test:startup-selftest-fallback && deno task test:startup-selftest-nominal"
  },
  "lint": {
    "exclude": ["I.ts", "UI/", "SINGULARITY/"],
    "rules": {
      "tags": ["recommended"],
      "exclude": ["no-explicit-any", "no-unused-vars"]
    }
  },
  "imports": {
    "@omega": "./mod.ts"
  }
}
