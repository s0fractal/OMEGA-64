{
  "compilerOptions": { "lib": ["deno.window"], "strict": true },
  "tasks": {
    "lint": "deno lint",
    "audit:determinism": "deno run -A 8/7/DETERMINISM_AUDIT/_.ts",
    "audit:determinism:signal": "deno run -A 8/7/DETERMINISM_AUDIT/_.ts --signal",
    "audit:drift": "deno run -A 8/3/DRIFT_CONTROLLER_CLI/_.ts",
    "audit:noncanonical": "deno run -A 8/1/NONCANONICAL_AUDIT/_.ts --json",
    "audit:dipole": "deno run -A 8/5/DIPOLE_IMPORT_AUDIT/_.ts",
    "audit:dipole:strict": "deno run -A 8/5/DIPOLE_IMPORT_AUDIT/_.ts --ts CONVERGE32 --mode FAIL --no-cache",
    "audit:yaml": "deno run -A e/AUDIT_YAML.ts",
    "audit:root": "deno run -A e/AUDIT_ROOT_CANON.ts",
    "audit:firewall": "deno run -A e/AUDIT_FIREWALL.ts",
    "export:sigma": "deno run -A e/EXPORT_SIGMA_CANON.ts --mode entity",
    "export:sigma:qview": "deno run -A e/EXPORT_SIGMA_CANON.ts --mode entity --include-q-view",
    "export:sigma:qlegacy": "deno run -A e/EXPORT_SIGMA_CANON.ts --mode entity --include-q-legacy",
    "export:sigma:level": "deno run -A e/EXPORT_SIGMA_CANON.ts --mode level",
    "sigma:roundtrip": "deno run -A e/legacy/sigma_quine.ts --input I.sigma.md --output I.sigma.reassembled.md",
    "sigma:verify": "deno run -A e/legacy/sigma_quine.ts --input I.sigma.md --output I.sigma.reassembled.md --verify",
    "sigma:index": "deno run -A e/legacy/sigma_index.ts --input I.sigma.md --output I.sigma.index.json",
    "sigma:colorize": "deno run -A e/legacy/sigma_colorize.ts --input I.sigma.md --index I.sigma.index.json --output I.sigma.colored.md",
    "bootstrap:dry": "deno run -A 8/6/BOOTSTRAP/_.ts",
    "bootstrap:dry:mounts": "deno run -A 8/6/BOOTSTRAP/_.ts --mounts e/legacy/i.L99.core.MOUNT_LIST.md",
    "mount:scan": "deno run -A 8/7/MOUNT_SCAN/_.ts --input e/legacy/i.L99.core.MOUNT_LIST.md",
    "q:pack": "deno run -A 8/5/QUANTUM_PACK_RUN/_.ts --write",
    "q:audit": "deno run -A 8/0/QUANTUM_AUDIT/_.ts",
    "q:audit:view": "deno run -A 8/0/QUANTUM_VIEW/_.ts && deno run -A 8/0/QUANTUM_AUDIT/_.ts",
    "q:view": "deno run -A 8/0/QUANTUM_VIEW/_.ts",
    "q:view:clean": "deno run -A 8/0/QUANTUM_VIEW/_.ts --clean",
    "canon:guard": "deno run -A e/CANON_NAME_GUARD.ts",
    "migrate:i": "deno run -A e/MIGRATE_I_CORE_TO_OCTAL.ts",
    "canon:imports": "deno run -A e/REWRITE_IMPORTS_TO_OMEGA.ts",
    "tests:imports": "deno run -A e/REWRITE_TEST_IMPORTS_TO_OMEGA.ts",
    "glider:run": "deno run -A 8/0/GLIDER_LITE_RUN/_.ts",
    "glider:breathe": "deno run -A 8/6/GLIDER_LITE_BREATHE/_.ts",
    "glider:breathe:once": "deno run -A 8/6/GLIDER_LITE_BREATHE/_.ts --once",
    "io:run": "deno run -A 8/3/IO_FLOW_RUN/_.ts",
    "o:append": "deno run -A 8/5/O_STREAM_APPEND_RUN/_.ts",
    "o:validate": "deno run -A 8/7/O_STREAM_VALIDATE_RUN/_.ts",
    "o:drain": "deno run -A 8/3/O_STREAM_DRAIN_RUN/_.ts",
    "o:summary": "deno run -A 8/3/O_STREAM_SUMMARY_RUN/_.ts",
    "o:archive-index": "deno run -A 8/6/O_STREAM_ARCHIVE_INDEX_RUN/_.ts",
    "o:archive-query": "deno run -A 8/4/O_STREAM_ARCHIVE_QUERY_RUN/_.ts",
    "o:filter-tags": "deno run -A 8/1/O_STREAM_FILTER_TAGS_RUN/_.ts",
    "o:tag-enforce": "deno run -A 8/2/O_STREAM_TAG_ENFORCE_RUN/_.ts",
    "o:tags-summary": "deno run -A 8/1/O_STREAM_TAGS_SUMMARY_RUN/_.ts",
    "o:health": "deno run -A 8/3/O_STREAM_HEALTH_RUN/_.ts",
    "o:health-signal": "deno run -A 8/0/O_STREAM_HEALTH_SIGNAL_RUN/_.ts",
    "o:health-signal:write": "deno run -A 8/6/O_STREAM_HEALTH_SIGNAL_WRITE/_.ts",
    "o:health:write": "deno run -A 8/1/O_STREAM_HEALTH_WRITE/_.ts",
    "o:health-signal:watch": "deno run -A 8/5/O_STREAM_SIGNAL_WATCH/_.ts",
    "io:health": "deno run -A 8/0/IO_FLOW_HEALTH_RUN/_.ts",
    "io:health-signal": "deno run -A 8/5/IO_FLOW_HEALTH_SIGNAL_RUN/_.ts",
    "io:health-signal:write": "deno run -A 8/3/IO_FLOW_HEALTH_SIGNAL_WRITE/_.ts",
    "io:health:write": "deno run -A 8/6/IO_FLOW_HEALTH_WRITE/_.ts",
    "io:health-signal:watch": "deno run -A 8/2/IO_FLOW_SIGNAL_WATCH/_.ts",
    "ui:health": "./ui_health.sh",
    "audit:genome": "deno run -A e/legacy/i.L99.core.GENOME_AUDIT_RUN.ts --root .",
    "audit:genome:map": "deno run -A 8/4/GENOME_MAP_RUN/_.ts",
    "scan:annotations": "deno run -A e/AUDIT_YAML.ts",
    "schema:gen": "deno run -A e/GEN_SCHEMA.ts",
    "canon:mod": "deno run -A e/GENERATE_MOD_TS.ts",
    "test:io-flow": "deno run -A tests/test_io_flow_stream.ts",
    "test:gate-runner": "deno run -A tests/test_gate_runner.ts",
    "test:replay": "deno run -A tests/test_replay_audit_topological_signature.ts",
    "test:crystallization": "deno run -A tests/test_replay_crystallization.ts",
    "test:spectral": "deno run -A tests/test_spectral_invariants.ts",
    "check:canon": "deno task lint && deno task audit:determinism && deno task test:replay && deno task test:crystallization && deno task test:gate-runner"
  },
  "lint": {
    "exclude": ["I.ts", "UI/", "SINGULARITY/"],
    "rules": {
      "tags": ["recommended"],
      "exclude": ["no-explicit-any", "no-unused-vars"]
    }
  },
  "imports": {
    // 🛡️ OMEGA-64 Singularity Imports
    "@std/": "https://deno.land/std@0.224.0/",
    "@omega": "./mod.ts",
    "websocket": "https://deno.land/x/websocket@v0.1.4/mod.ts"
  }
}
