    "daemon:start": "deno run -A OMEGA_DAEMON.ts",
    "membrane:test": "deno run -A SEMANTIC_MEMBRANE.ts",
    "membrane:inject": "deno eval 'import { SEMANTIC_MEMBRANE } from \"./SEMANTIC_MEMBRANE.ts\"; await SEMANTIC_MEMBRANE.injectThought(Deno.args[0] || \"Default Thought\", Number(Deno.args[1]) || 100)' --",
