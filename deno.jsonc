{
  "compilerOptions": { "lib": ["deno.window"], "strict": true },
  "tasks": {
    "lint": "deno lint",
    "audit:determinism": "deno run -A i.L99.core.DETERMINISM_AUDIT.ts",
    "audit:determinism:signal": "deno run -A i.L99.core.DETERMINISM_AUDIT.ts --signal",
    "audit:drift": "deno run -A i.L99.core.DRIFT_CONTROLLER_CLI.ts",
    "audit:noncanonical": "deno run -A i.L99.core.NONCANONICAL_AUDIT.ts --json",
    "export:sigma": "deno run -A export_sigma.ts --mode entity",
    "export:sigma:level": "deno run -A export_sigma.ts --mode level",
    "sigma:roundtrip": "deno run -A sigma_quine.ts --input I.sigma.md --output I.sigma.reassembled.md",
    "sigma:verify": "deno run -A sigma_quine.ts --input I.sigma.md --output I.sigma.reassembled.md --verify",
    "sigma:index": "deno run -A sigma_index.ts --input I.sigma.md --output I.sigma.index.json",
    "sigma:colorize": "deno run -A sigma_colorize.ts --input I.sigma.md --index I.sigma.index.json --output I.sigma.colored.md",
    "glider:run": "deno run -A i.L99.core.GLIDER_LITE_RUN.ts",
    "io:run": "deno run -A i.L99.core.IO_FLOW_RUN.ts",
    "o:append": "deno run -A i.L99.core.O_STREAM_APPEND_RUN.ts",
    "o:validate": "deno run -A i.L99.core.O_STREAM_VALIDATE_RUN.ts",
    "o:drain": "deno run -A i.L99.core.O_STREAM_DRAIN_RUN.ts",
    "o:summary": "deno run -A i.L99.core.O_STREAM_SUMMARY_RUN.ts",
    "o:archive-index": "deno run -A i.L99.core.O_STREAM_ARCHIVE_INDEX_RUN.ts",
    "o:archive-query": "deno run -A i.L99.core.O_STREAM_ARCHIVE_QUERY_RUN.ts",
    "o:filter-tags": "deno run -A i.L99.core.O_STREAM_FILTER_TAGS_RUN.ts",
    "o:tag-enforce": "deno run -A i.L99.core.O_STREAM_TAG_ENFORCE_RUN.ts",
    "o:tags-summary": "deno run -A i.L99.core.O_STREAM_TAGS_SUMMARY_RUN.ts",
    "o:health": "deno run -A i.L99.core.O_STREAM_HEALTH_RUN.ts",
    "o:health-signal": "deno run -A i.L99.core.O_STREAM_HEALTH_SIGNAL_RUN.ts",
    "io:health": "deno run -A i.L99.core.IO_FLOW_HEALTH_RUN.ts",
    "io:health-signal": "deno run -A i.L99.core.IO_FLOW_HEALTH_SIGNAL_RUN.ts",
    "test:io-flow": "deno run -A test_io_flow_stream.ts",
    "test:gate-runner": "deno run -A test_gate_runner.ts",
    "test:replay": "deno run -A test_replay_audit_topological_signature.ts",
    "test:crystallization": "deno run -A test_replay_crystallization.ts",
    "check:canon": "deno task lint && deno task audit:determinism && deno task test:replay && deno task test:crystallization && deno task test:gate-runner"
  },
  "lint": {
    "exclude": ["I.ts", "UI/", "SINGULARITY/"],
    "rules": {
      "tags": ["recommended"],
      "exclude": ["no-explicit-any", "no-unused-vars"]
    }
  },
  "imports": {
    // 🛡️ OMEGA-64 Singularity Imports
    "@std/": "https://deno.land/std@0.224.0/",
    "websocket": "https://deno.land/x/websocket@v0.1.4/mod.ts"
  }
}
