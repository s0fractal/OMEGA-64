{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "omega.schema.json",
  "title": "OMEGA YAML Canon",
  "description": "Canonical schema for _.yaml nodes in the octal topology.",
  "oneOf": [
    { "$ref": "#/definitions/RootMeta" },
    { "$ref": "#/definitions/OctaveMeta" },
    { "$ref": "#/definitions/AtomMeta" }
  ],
  "definitions": {
    "Tags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "Vector": {
      "type": "string",
      "description": "Octal vector: major.minor.variant (0..8, 0..7, 0..15).",
      "pattern": "^(0[0-8])\\.(0[0-7])\\.(0[0-9]|1[0-5])$"
    },
    "Relations": {
      "type": "object",
      "properties": {
        "use": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": {
        "type": "array",
        "items": { "type": "string" }
      }
    },
    "RootMeta": {
      "type": "object",
      "properties": {
        "standard": { "type": "string" },
        "version": { "type": ["string", "number"] },
        "note": { "type": "string" },
        "tags": { "$ref": "#/definitions/Tags" }
      },
      "required": ["standard", "version"],
      "additionalProperties": false
    },
    "OctaveMeta": {
      "type": "object",
      "properties": {
        "major": { "type": "integer", "minimum": 0, "maximum": 7 },
        "note": { "type": "string" },
        "tags": { "$ref": "#/definitions/Tags" }
      },
      "required": ["major", "note"],
      "additionalProperties": false
    },
    "AtomMeta": {
      "type": "object",
      "properties": {
        "vector": { "$ref": "#/definitions/Vector" },
        "symbol": { "type": "string" },
        "desc": { "type": "string" },
        "legacy_idx": { "type": "integer", "minimum": -1 },
        "origin": { "type": "string" },
        "relations": { "$ref": "#/definitions/Relations" },
        "tags": { "$ref": "#/definitions/Tags" }
      },
      "required": ["vector", "symbol", "desc", "legacy_idx", "origin"],
      "additionalProperties": false
    }
  }
}
